+// Manual-only current-field Courant estimate. Coarse reduction preserves MAX/SUM.
+float4 main(PS_IN pin) {
+    int2 block=min((int2)(pin.Tex*gFilmReductionSize),(int2)gFilmReductionSize-1);
+    float4 result=0;
+    [loop]for(int y=0;y<16;++y) [loop]for(int x=0;x<16;++x) {
+        int2 p=block*16+int2(x,y);
+        if(any(p>=(int2)gFilmPaddedSize))continue;
+        float4 value=0;
+        if(gFilmFlowReduce>.5)value=txFilmFlowBlocks.Load(int3(p,0));
+        else {
+            FilmFlow f=ffEvaluate(p);
+            float volume=max(txFilmPrevious.Load(int3(p,0)).r,0);
+            value=float4(f.courant,f.courant>gFilmFlowCFL ? 1 : 0,volume>0 ? 1 : 0,
+                f.courant>gFilmFlowCFL ? volume : 0);
+        }
+        result.x=max(result.x,value.x);result.yzw+=value.yzw;
+    }
+    return result;
+}
